{
  "name": "smv-player",
  "version": "4.0.0",
  "description": "SMV Player — lecteur IPTV (Stalker / M3U) auto-hébergé : serveur Node + interface web, HTTPS, Docker, Raspberry Pi",
  "main": "server/index.js",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"test/*.test.js\"",
    "reset-password": "node server/admin.js reset-password"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "hls.js": "^1.7.3",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "mpegts.js": "^1.8.2",
    "proxy-from-env": "^2.1.0",
    "qrcode": "^1.5.4"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
