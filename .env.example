# ─── SMV Player : configuration du déploiement Docker ───────────────────────
# Copiez ce fichier en « .env » puis adaptez-le.

# Adresse publique du serveur, sans https:// (domaine personnel ou DuckDNS).
# « localhost » pour un essai sur le PC ; plusieurs adresses séparées par des
# virgules suivies d'une espace, ex. : tv.exemple.fr, 192.168.1.20
DOMAIN=localhost

# Compte administrateur créé au premier démarrage (8 caractères minimum).
# Laissé vide : un code d'installation s'affiche dans « docker compose logs smv ».
# Mot de passe avec $, # ou espaces : entourez-le d'apostrophes, ex. 'mon$mot de passe'
SMV_ADMIN_USER=admin
SMV_ADMIN_PASSWORD=

# Nombre maximal de flux transcodés en même temps (Raspberry Pi : 1 ou 2)
SMV_MAX_TRANSCODES=2

# Encodeur H.264 utilisé pour les qualités réduites (720p, 480p…) :
#   vide = libx264 (logiciel) ; h264_v4l2m2m = encodeur matériel du Raspberry Pi 4
#   (décommentez alors « devices » dans docker-compose.yml). Le Pi 5 n'en a pas.
SMV_H264_ENCODER=
# Préréglage libx264 (vide = ultrafast sur ARM, veryfast sur PC)
SMV_X264_PRESET=

# Ports publiés par Caddy. Gardez 80 et 443 pour l'accès depuis Internet ;
# changez-les seulement pour un essai local si ces ports sont déjà pris.
HTTP_PORT=80
HTTPS_PORT=443

TZ=Europe/Paris

# DuckDNS (facultatif) : nom de domaine gratuit qui suit votre IP publique.
# Sous-domaine sans « .duckdns.org » et jeton affiché sur duckdns.org.
# Démarrage : docker compose --profile duckdns up -d
DUCKDNS_SUBDOMAINS=
DUCKDNS_TOKEN=

# Cloudflare Tunnel (facultatif) : accès HTTPS depuis Internet sans ouvrir de
# port sur la box (idéal derrière une box 4G/5G ou en CGNAT). Créez le tunnel sur
# https://one.dash.cloudflare.com (Zero Trust › Networks › Tunnels), collez ici le
# jeton affiché, puis routez le nom public vers « http://smv:9191 ».
# Démarrage : docker compose --profile cloudflare up -d
CLOUDFLARE_TUNNEL_TOKEN=
